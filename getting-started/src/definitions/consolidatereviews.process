<process xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne" id="consolidatereviews.process" name="consolidatereviews" implementationType="http://www.omg.org/spec/CMMN/ProcessType/Unspecified">
    <documentation textFormat="text/plain"><text><![CDATA[Consolidate appraisal reviews - replace the URL with your real service]]></text></documentation>
    <output id="consolidatereviews_responseCode" name="responseCode"/>
    <extensionElements mustUnderstand="false">
        <cafienne:implementation xmlns:cafienne="org.cafienne" class="org.cafienne.processtask.implementation.http.HTTPCallDefinition">
            <url>http://localhost:8080/appraisal/consolidate</url>
            <method>POST</method>
            <post-content>{}</post-content>
            <http-headers>
                <http-header name="Content-Type">application/json</http-header>
            </http-headers>
            <parameterMapping sourceRef="responseCode" targetRef="responseCode"/>
        </cafienne:implementation>
    </extensionElements>
</process>

<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="WorkOnPIP" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">
        <input id="goals__c9d7d" name="goals" typeRef="string"/>
        <input id="status__2fd0e" name="status" typeRef="string"/>
        <output id="status__17fcf" name="status" typeRef="string"/>
        <task-model>{
  "schema": {
    "title": "Work on improvement plan",
    "type": "object",
    "properties": {
      "goals": {
        "type": "string",
        "title": "PIP goals",
        "readOnly": true
      },
      "status": {
        "type": "string",
        "title": "Progress update"
      }
    }
  },
  "uiSchema": {
    "ui:order": [
      "goals",
      "status"
    ],
    "goals": {
      "ui:widget": "textarea"
    },
    "status": {
      "ui:widget": "textarea"
    }
  }
}</task-model>
    </cafienne:implementation>
</humanTask>

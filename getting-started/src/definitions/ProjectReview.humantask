<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="ProjectReview" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">
        <input id="name__a7c82" name="name" typeRef="string"/>
        <input id="projectId__3bfaf" name="projectId" typeRef="string"/>
        <output id="reviewOutcome__0f9c2" name="reviewOutcome" typeRef="string"/>
        <output id="skillGap__f06f8" name="skillGap" typeRef="boolean"/>
        <task-model>{
  "schema": {
    "title": "Project / performance review",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "title": "Full name",
        "readOnly": true
      },
      "projectId": {
        "type": "string",
        "title": "Project ID",
        "readOnly": true
      },
      "reviewOutcome": {
        "type": "string",
        "title": "Review outcome",
        "enum": [
          "continue",
          "nextProject",
          "poorPerformance"
        ]
      },
      "skillGap": {
        "type": "boolean",
        "title": "Skill gap identified",
        "default": false
      }
    },
    "required": [
      "reviewOutcome"
    ]
  },
  "uiSchema": {
    "ui:order": [
      "name",
      "projectId",
      "reviewOutcome",
      "skillGap"
    ],
    "reviewOutcome": {
      "ui:widget": "radio"
    }
  }
}</task-model>
    </cafienne:implementation>
</humanTask>

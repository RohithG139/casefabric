<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="AssignProject" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">
        <input id="name__0e573" name="name" typeRef="string"/>
        <input id="role__4c6e9" name="role" typeRef="string"/>
        <output id="projectName__c6425" name="projectName" typeRef="string"/>
        <output id="accepted__f9f2c" name="accepted" typeRef="boolean"/>
        <task-model>{
  "schema": {
    "title": "Assign project",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "title": "Full name",
        "readOnly": true
      },
      "role": {
        "type": "string",
        "title": "Role",
        "readOnly": true
      },
      "projectName": {
        "type": "string",
        "title": "Project name"
      },
      "accepted": {
        "type": "boolean",
        "title": "Assignment accepted",
        "default": false
      }
    },
    "required": [
      "projectName",
      "accepted"
    ]
  },
  "uiSchema": {
    "ui:order": [
      "name",
      "role",
      "projectName",
      "accepted"
    ]
  }
}</task-model>
    </cafienne:implementation>
</humanTask>

                            <cafienne:implementation xmlns:cafienne="org.cafienne" humanTaskRef="DefinePIP.humantask">
                                <parameterMapping id="pm_pip_goals_in_name" sourceRef="in_pip_goals_Employee" targetRef="name__ec315">
                                    <transformation id="pm_pip_goals_in_name_t">
                                        <body><![CDATA[Employee?.name]]></body>
                                    </transformation>
                                </parameterMapping>

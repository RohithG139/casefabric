                    <planItemOnPart id="op_s_pip_work" sourceRef="pi_perf_concern">
                        <standardEvent>occur</standardEvent>
                    </planItemOnPart>
                </entryCriterion>
                <entryCriterion id="ec_s_pip_appr">
                    <ifPart contextRef="Appraisal">
                        <condition>
                            <body><![CDATA[Appraisal?.outcome == 'poor' and case.file.PIP?.status != 'active']]></body>
                        </condition>
                    </ifPart>
                    <planItemOnPart id="op_s_pip_appr" sourceRef="pi_finalize">
                        <standardEvent>complete</standardEvent>
                    </planItemOnPart>
                </entryCriterion>
                <itemControl>
                    <repetitionRule>
                        <condition>
                            <body><![CDATA[true]]></body>
                        </condition>
                    </repetitionRule>
                </itemControl>
                <stage id="pi_pip_setup" name="Set up PIP" autoComplete="true">
                    <humanTask id="pi_pip_goals" name="Define PIP goals" isBlocking="true" performerRef="cr__8b8pm_1">
                        <documentation textFormat="text/plain">
                            <text><![CDATA[Owner: Manager]]></text>
                        </documentation>
                        <inputs id="in_pip_goals_Employee" name="Employee" bindingRef="Employee"/>
                        <inputs id="in_pip_goals_Appraisal" name="Appraisal" bindingRef="Appraisal"/>
                        <inputs id="in_pip_goals_ProjectAssignment" name="ProjectAssignment" bindingRef="ProjectAssignment"/>
                        <outputs id="out_pip_goals_goals" name="PIP.goals" bindingRef="PIP"/>
                        <outputs id="out_pip_goals_employeeEmail" name="PIP.employeeEmail" bindingRef="PIP"/>

                                    <body><![CDATA[DevelopmentPlan?.activities?.![value]?.contains('training') == true]]></body>
                                </condition>
                            </applicabilityRule>
                            <applicabilityRule id="ar_act_coaching" name="if selected" contextRef="DevelopmentPlan">
                                <condition>
                                    <body><![CDATA[DevelopmentPlan?.activities?.![value]?.contains('coaching') == true]]></body>
                                </condition>

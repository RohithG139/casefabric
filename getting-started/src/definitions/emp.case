                                    <transformation id="pm_pip_revise_out_employeeEmail_t">
                                        <body><![CDATA[{'employeeEmail':employeeEmail}]]></body>
                                    </transformation>
                                </parameterMapping>
                            </cafienne:implementation>
                        </extensionElements>
                    </humanTask>
                    <humanTask id="pi_pip_approve" name="Review and approve PIP" isBlocking="true" performerRef="cr__8b8pm_2">
                        <documentation textFormat="text/plain">
                            <text><![CDATA[Owner: HR]]></text>
                        </documentation>
                        <entryCriterion id="ec_s_pipapprove">
                            <planItemOnPart id="op_s_pipapprove" sourceRef="pi_pip_goals">
                                <standardEvent>complete</standardEvent>
                            </planItemOnPart>
                        </entryCriterion>
                        <entryCriterion id="ec_s_pipapprove_again">
                            <planItemOnPart id="op_s_pipapprove_again" sourceRef="pi_pip_revise">
                                <standardEvent>complete</standardEvent>
                            </planItemOnPart>
                        </entryCriterion>
                        <entryCriterion id="ec_s_dispute">
                            <ifPart contextRef="PIP">
                                <condition>
                                    <body><![CDATA[PIP?.acknowledged != true]]></body>
                                </condition>

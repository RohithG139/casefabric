                                    <transformation id="pm_pip_revise_in_email_t">
                                        <body><![CDATA[Employee?.email]]></body>
                                    </transformation>
                                </parameterMapping>
                                <parameterMapping id="pm_pip_revise_in_outcome" sourceRef="in_pip_revise_Appraisal" targetRef="outcome__cf399">
                                    <transformation id="pm_pip_revise_in_outcome_t">
                                        <body><![CDATA[Appraisal?.outcome]]></body>
                                    </transformation>
                                </parameterMapping>
                                <parameterMapping id="pm_pip_revise_in_reviewOutcome" sourceRef="in_pip_revise_ProjectAssignment" targetRef="reviewOutcome__83af1">
                                    <transformation id="pm_pip_revise_in_reviewOutcome_t">
                                        <body><![CDATA[ProjectAssignment?.reviewOutcome]]></body>
                                    </transformation>
                                </parameterMapping>
                                <parameterMapping id="pm_pip_revise_out_goals" sourceRef="goals__b2c37" targetRef="out_pip_revise_goals">
                                    <transformation id="pm_pip_revise_out_goals_t">
                                        <body><![CDATA[{'goals':goals,'status':'active'}]]></body>
                                    </transformation>
                                </parameterMapping>

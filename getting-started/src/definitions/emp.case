                                    <transformation id="pm_pip_goals_in_reviewOutcome_t">
                                        <body><![CDATA[ProjectAssignment?.reviewOutcome]]></body>
                                    </transformation>
                                </parameterMapping>
                                <parameterMapping id="pm_pip_goals_out_goals" sourceRef="goals__b2c37" targetRef="out_pip_goals_goals">
                                    <transformation id="pm_pip_goals_out_goals_t">
                                        <body><![CDATA[{'goals':goals,'status':'active','extended':false}]]></body>
                                    </transformation>
                                </parameterMapping>
                                <parameterMapping id="pm_pip_goals_out_employeeEmail" sourceRef="employeeEmail__d2633" targetRef="out_pip_goals_employeeEmail">
                                    <transformation id="pm_pip_goals_out_employeeEmail_t">
                                        <body><![CDATA[{'employeeEmail':employeeEmail}]]></body>
                                    </transformation>
                                </parameterMapping>
                            </cafienne:implementation>
                        </extensionElements>
                    </humanTask>
                    <humanTask id="pi_pip_revise" name="Revise PIP goals" isBlocking="true" performerRef="cr__8b8pm_1">
                        <documentation textFormat="text/plain">
                            <text><![CDATA[Owner: Manager. Runs when HR does not approve the PIP; then HR reviews again.]]></text>
                        </documentation>
                        <entryCriterion id="ec_s_pip_revise">
                            <ifPart contextRef="PIP">
                                <condition>
                                    <body><![CDATA[PIP?.hrApproved != true]]></body>
                                </condition>
                            </ifPart>
                            <planItemOnPart id="op_s_pip_revise" sourceRef="pi_pip_approve">
                                <standardEvent>complete</standardEvent>
                            </planItemOnPart>
                        </entryCriterion>
                        <itemControl>
                            <repetitionRule>
                                <condition>
                                    <body><![CDATA[true]]></body>
                                </condition>
                            </repetitionRule>
                        </itemControl>
                        <inputs id="in_pip_revise_Employee" name="Employee" bindingRef="Employee"/>
                        <inputs id="in_pip_revise_Appraisal" name="Appraisal" bindingRef="Appraisal"/>
                        <inputs id="in_pip_revise_ProjectAssignment" name="ProjectAssignment" bindingRef="ProjectAssignment"/>
                        <outputs id="out_pip_revise_goals" name="PIP.goals" bindingRef="PIP"/>
                        <outputs id="out_pip_revise_employeeEmail" name="PIP.employeeEmail" bindingRef="PIP"/>

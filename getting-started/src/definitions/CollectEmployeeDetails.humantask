<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="CollectEmployeeDetails" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">

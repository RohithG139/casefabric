<humanTask xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne">
    <cafienne:implementation name="ReviewProgress" class="org.cafienne.cmmn.definition.task.WorkflowTaskDefinition">
        <input id="goals__740ad" name="goals" typeRef="string"/>
        <input id="activities__9407a" name="activities" typeRef="string"/>
        <input id="progress__b5c64" name="progress" typeRef="string"/>
        <output id="progress__f15bf" name="progress" typeRef="string"/>
        <task-model>{
  "schema": {
    "title": "Review progress",
    "type": "object",
    "properties": {
      "goals": {
        "type": "string",
        "title": "Development goals",
        "readOnly": true
      },
      "activities": {
        "type": "array",
        "title": "Activities",
        "items": {
          "type": "string",
          "enum": [
            "projects",
            "training",
            "coaching"
          ]
        },
        "readOnly": true,
        "uniqueItems": true
      },
      "progress": {
        "type": "string",
        "title": "Progress",
        "enum": [
          "onTrack",
          "behind",
          "done"
        ]
      }
    },
    "required": [
      "progress"
    ]
  },
  "uiSchema": {
    "ui:order": [
      "goals",
      "activities",
      "progress"
    ],
    "goals": {
      "ui:widget": "textarea"
    },
    "progress": {
      "ui:widget": "radio"
    },
    "activities": {
      "ui:widget": "checkboxes"
    }
  }
}</task-model>
    </cafienne:implementation>
</humanTask>

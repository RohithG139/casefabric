<process xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cafienne="org.cafienne" name="SendPIPNotice" implementationType="http://www.omg.org/spec/CMMN/ProcessType/Unspecified">
    <documentation textFormat="text/plain">
        <text><![CDATA[Mail service: send the PIP notice]]></text>
    </documentation>
    <input id="employeeEmail__eed4b" name="employeeEmail" typeRef="string"/>
    <input id="noticeText__d8013" name="noticeText" typeRef="string"/>
    <input id="goals__9bedf" name="goals" typeRef="string"/>
    <extensionElements mustUnderstand="false">
        <cafienne:implementation class="org.cafienne.processtask.implementation.http.HTTPCallDefinition" async="true" xmlns:cafienne="org.cafienne">
            <url xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL">http://mock-api:8390/api/SendPIPNotice</url>
            <method xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL">POST</method>
            <post-content xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL">{"employeeEmail": "${employeeEmail}", "noticeText": "${noticeText}", "goals": "${goals}"}</post-content>
            <http-headers xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL">
                <http-header name="Content-Type">application/json</http-header>
            </http-headers>
        </cafienne:implementation>
    </extensionElements>
</process>
